{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassworks.local/contracts/state.schema.json",
  "title": "GlassworksState",
  "description": "Complete authoritative snapshot carried by every state-changing server fact. Derived fields are computed at serialization time. Invariants that JSON Schema cannot express: pieces are empty while season_open is false; a piece is referenced by exactly one furnace or bench; glassblowers.busy counts furnace_heating, furnace_ready, and bench_working pieces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_time",
    "season",
    "season_open",
    "sand",
    "glass",
    "glassblowers",
    "furnaces",
    "benches",
    "pieces"
  ],
  "properties": {
    "server_time": {
      "type": "number",
      "description": "Server epoch seconds at snapshot time; clients use it to correct countdowns."
    },
    "season": {
      "type": "integer",
      "minimum": 0,
      "description": "0 before the first season; increments on every glassworks.started."
    },
    "season_open": {
      "type": "boolean"
    },
    "sand": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "glass": {
      "type": "integer",
      "minimum": 0
    },
    "glassblowers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "busy", "free"],
      "properties": {
        "total": {
          "const": 8
        },
        "busy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "free": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "furnaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "piece_id"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "piece_id": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    },
    "benches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "piece_id", "cooling_ends_at"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "piece_id": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "cooling_ends_at": {
            "type": ["number", "null"],
            "description": "Epoch seconds; non-null only while the bench piece is bench_cooling."
          }
        }
      }
    },
    "pieces": {
      "type": "object",
      "description": "Keyed by piece id as a decimal string.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "state",
            "furnace_id",
            "bench_id",
            "ready_at",
            "cooling_started_at",
            "cooling_ends_at"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "enum": [
                "furnace_heating",
                "furnace_ready",
                "bench_working",
                "bench_cooling"
              ]
            },
            "furnace_id": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 4
            },
            "bench_id": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 4
            },
            "ready_at": {
              "type": ["number", "null"],
              "description": "Epoch seconds; heating or bench-work deadline."
            },
            "cooling_started_at": {
              "type": ["number", "null"]
            },
            "cooling_ends_at": {
              "type": ["number", "null"]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
